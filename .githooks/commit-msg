#!/bin/sh
# Strip coding-agent Co-authored-by trailers from commit messages.
# Install: git config core.hooksPath .githooks

MSG_FILE="$1"
if [ -z "$MSG_FILE" ] || [ ! -f "$MSG_FILE" ]; then
  exit 0
fi

tmp="${MSG_FILE}.tmp"
# Remove Cursor / common agent trailers only (keep legitimate human co-authors).
grep -v -E '^Co-authored-by:[[:space:]]*(Cursor|cursoragent|Claude|ChatGPT|OpenAI|GitHub Copilot|Copilot)' "$MSG_FILE" \
  | grep -v -E '^Generated-by:' \
  | grep -v -E '^Generated by:' \
  > "$tmp" || true

# Trim trailing blank lines
# portable: rewrite file without trailing empty lines
python3 - "$tmp" "$MSG_FILE" <<'PY'
import sys
src, dst = sys.argv[1], sys.argv[2]
text = open(src, "r", encoding="utf-8").read().replace("\r\n", "\n")
lines = text.split("\n")
while lines and lines[-1].strip() == "":
    lines.pop()
open(dst, "w", encoding="utf-8").write("\n".join(lines) + ("\n" if lines else ""))
PY
rm -f "$tmp"
exit 0
