# syntax=docker/dockerfile:1
FROM python:3.12-slim

WORKDIR /app

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1

COPY requirements-docker.txt ./
RUN pip install --no-cache-dir -r requirements-docker.txt

COPY alembic.ini ./
COPY alembic ./alembic
COPY backend ./backend
COPY ml ./ml
COPY scripts/docker_backend_entrypoint.py ./scripts/docker_backend_entrypoint.py

EXPOSE 8000

ENTRYPOINT ["python", "scripts/docker_backend_entrypoint.py"]
