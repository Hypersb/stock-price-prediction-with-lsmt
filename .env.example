# Copy these placeholders to a local .env and fill values.
# Never commit .env, .env.local, or real credentials.
#
# Development credentials below are placeholders only — not for production.
# Backend loads repo-root .env only when APP_ENV=development (unless
# QUANT_LOAD_DOTENV=false). Production never loads .env files.

# --- Environment ---
# development | test | production
APP_ENV=development
APP_NAME=stock-price-prediction-research-api
APP_VERSION=0.1.0
API_V1_PREFIX=/api/v1
LOG_LEVEL=DEBUG
# QUANT_LOAD_DOTENV=true

# --- CORS (PUBLIC/INTERNAL) ---
# Prefer FRONTEND_ORIGIN for a single origin, or CORS_ORIGINS as a comma list.
# Production must not use '*'. Empty origins disable browser CORS.
FRONTEND_ORIGIN=http://localhost:3000
CORS_ORIGINS=
CORS_ALLOW_CREDENTIALS=true

# --- Database (SECRET credentials inside URL) ---
# Required when APP_ENV=production. Optional in development/test.
# Development placeholder only.
DATABASE_URL=postgresql+psycopg://user:password@localhost:5432/quant_research
# ALLOW_NONLOCAL_TEST_DATABASE=false

# --- Market data (INTERNAL + optional SECRET) ---
MARKET_DATA_PROVIDER=yahoo
# Optional future provider credential. Never expose via NEXT_PUBLIC_*.
MARKET_DATA_API_KEY=

# --- Auth (SECRET, optional) ---
# Empty = single-user mode (auth dependency is a no-op). Set to enable X-API-Key.
AUTH_API_KEY=
MAX_MARKET_DATA_DAYS=3650
MAX_MARKET_ROWS=5000
MAX_FEATURE_ROWS=500
MAX_PAGE_SIZE=100
DEFAULT_PAGE_SIZE=20
MAX_REQUEST_BODY_BYTES=1048576
MARKET_DATA_CACHE_TTL_SECONDS=60
MARKET_DATA_CACHE_MAX_SIZE=64

# --- Paths (INTERNAL) ---
# Relative paths resolve from the repository root.
# QUANT_DATA_ROOT=data
# QUANT_ARTIFACT_ROOT=artifacts

# --- Frontend (Next.js) — PUBLIC browser values only ---
# Do not put database passwords or private API keys in NEXT_PUBLIC_* variables.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# Optional server-only override for Docker Compose SSR (not exposed to browsers).
# API_INTERNAL_BASE_URL=http://backend:8000
