# Copy these placeholders to a local .env (or frontend/.env.local) and fill values.
# Never commit .env, .env.local, or real credentials.
#
# Development credentials below are placeholders only — not for production.

# --- Backend (FastAPI) ---
APP_ENV=development
APP_NAME=stock-price-prediction-research-api
APP_VERSION=0.1.0
API_V1_PREFIX=/api/v1

# Browser origin allowed by CORS. Prefer FRONTEND_ORIGIN for a single origin,
# or CORS_ORIGINS as a comma-separated list. In production both are empty by
# default (no wildcard).
FRONTEND_ORIGIN=http://localhost:3000
CORS_ORIGINS=
CORS_ALLOW_CREDENTIALS=true

# Required when APP_ENV=production. Optional in development (read APIs that
# need persistence will fail until set). Development placeholder only.
DATABASE_URL=postgresql+psycopg://user:password@localhost:5432/quant_research

# Optional future market-data provider credential. Never expose via NEXT_PUBLIC_*.
MARKET_DATA_API_KEY=

# Request/response safeguards (safe development defaults)
MAX_MARKET_DATA_DAYS=3650
MAX_MARKET_ROWS=5000
MAX_FEATURE_ROWS=500
MAX_PAGE_SIZE=100
DEFAULT_PAGE_SIZE=20
MAX_REQUEST_BODY_BYTES=1048576
MARKET_DATA_CACHE_TTL_SECONDS=60
MARKET_DATA_CACHE_MAX_SIZE=64

# --- Frontend (Next.js) — public browser values only ---
# Do not put database passwords or private API keys in NEXT_PUBLIC_* variables.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# Optional server-only override for Docker Compose SSR (not exposed to browsers).
# API_INTERNAL_BASE_URL=http://backend:8000
