# Copy these placeholders to a local .env file and fill in real values there.
# Never commit .env or any real credentials.
APP_ENV=development
APP_NAME=stock-price-prediction-research-api
APP_VERSION=0.1.0
FRONTEND_ORIGIN=http://localhost:3000
CORS_ORIGINS=
DATABASE_URL=postgresql+psycopg://user:password@localhost:5432/quant_research
